# Copy this file to config/robot.env and fill the address after you check the robot.
# config/robot.env is gitignored.

# Default user on the official TurtleBot3 image.
ROBOT_USER=ubuntu

# IPv4 address of the robot on the local network.
ROBOT_HOST=

# Optional private key. Leave unset to use the default SSH keys.
# ROBOT_SSH_KEY=
