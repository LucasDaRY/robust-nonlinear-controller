# Source this file after activating the humble environment.
# The TurtleBot3 single-board computer must use the same three values.
# Change them here when you have checked the robot.

# Official TurtleBot3 Humble PC setup uses domain 30.
export ROS_DOMAIN_ID=30

# Burger model. Waffle and Waffle Pi use other names.
export TURTLEBOT3_MODEL=burger

# Ubuntu Humble on the robot uses Fast DDS unless you changed it.
# The laptop must use the same RMW implementation or the topics stay invisible.
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# 0 allows discovery on the local network. 1 limits ROS 2 to this machine.
export ROS_LOCALHOST_ONLY=0
