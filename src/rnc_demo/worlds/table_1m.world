<?xml version="1.0"?>
<!--
  1 m by 1 m table used as the testing zone.
  The clear driving surface, inside the rim, is 1.00 m by 1.00 m.
  The top face is at z = 0.75 m. Spawn the Burger at z = 0.76 m.
-->
<sdf version="1.6">
  <world name="table_1m">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose frame="">1.35 -1.25 1.45 0 0.55 2.35</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.4</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <model name="table">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <link name="top">
        <pose>0 0 0.73 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>1.04 1.04 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.04 1.04 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.38 0.22 1</ambient>
            <diffuse>0.55 0.38 0.22 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Rim inner faces sit at x = ±0.50 m and y = ±0.50 m. -->
      <link name="rim_north">
        <pose>0 0.51 0.775 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>1.04 0.02 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.04 0.02 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.24 0.14 1</ambient>
            <diffuse>0.35 0.24 0.14 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="rim_south">
        <pose>0 -0.51 0.775 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>1.04 0.02 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.04 0.02 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.24 0.14 1</ambient>
            <diffuse>0.35 0.24 0.14 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="rim_east">
        <pose>0.51 0 0.775 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.02 1.00 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.02 1.00 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.24 0.14 1</ambient>
            <diffuse>0.35 0.24 0.14 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="rim_west">
        <pose>-0.51 0 0.775 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.02 1.00 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.02 1.00 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.24 0.14 1</ambient>
            <diffuse>0.35 0.24 0.14 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="leg_ne">
        <pose>0.46 0.46 0.355 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.71</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.71</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="leg_nw">
        <pose>-0.46 0.46 0.355 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.71</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.71</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="leg_se">
        <pose>0.46 -0.46 0.355 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.71</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.71</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="leg_sw">
        <pose>-0.46 -0.46 0.355 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.71</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.71</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
