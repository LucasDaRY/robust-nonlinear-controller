<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.7">
  <world name="asymmetric_room">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!--
      Closed room with no parallel-wall symmetry.
      The figure-8 stays inside x [-0.5, 0.5], y [-1.2, -0.2], spawn at the origin.
      Walls and posts sit outside x [-0.95, 0.95], y [-1.6, 0.4].
      The Burger lidar is a full 360 deg scan with max range 3.5 m, so every pose
      in that area sees a different range image: a jog on the north-west, a step
      on the east, and three posts of different shapes.
      Wall height is 0.8 m. The LDS beam is near 0.18 m.
    -->

    <model name="wall_south">
      <static>true</static>
      <pose>-0.05 -2.30 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.70 0.12 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.70 0.12 0.80</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east_lower">
      <static>true</static>
      <pose>2.30 -1.40 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 1.80 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.12 1.80 0.80</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east_step">
      <static>true</static>
      <pose>1.90 -0.50 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.80 0.12 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.80 0.12 0.80</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east_upper">
      <static>true</static>
      <pose>1.50 0.70 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 2.40 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.12 2.40 0.80</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0.15 1.90 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.70 0.12 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.70 0.12 0.80</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north_jog">
      <static>true</static>
      <pose>-1.20 1.55 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 0.70 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.12 0.70 0.80</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north_west">
      <static>true</static>
      <pose>-1.80 1.20 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.20 0.12 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.20 0.12 0.80</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-2.40 -0.55 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 3.50 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.12 3.50 0.80</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Breaks the long north face, so sliding along that wall changes the scan. -->
    <model name="buttress_north">
      <static>true</static>
      <pose>-0.30 1.55 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.22 0.70 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.22 0.70 0.80</size></box></geometry>
          <material><ambient>0.75 0.45 0.20 1</ambient><diffuse>0.75 0.45 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="post_cylinder">
      <static>true</static>
      <pose>1.05 1.35 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.18</radius><length>0.80</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.80</length></cylinder></geometry>
          <material><ambient>0.20 0.25 0.80 1</ambient><diffuse>0.20 0.25 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="post_square">
      <static>true</static>
      <pose>-1.70 -1.20 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.36 0.36 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.36 0.36 0.80</size></box></geometry>
          <material><ambient>0.15 0.65 0.25 1</ambient><diffuse>0.15 0.65 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="post_slab">
      <static>true</static>
      <pose>1.15 -1.95 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.55 0.18 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.55 0.18 0.80</size></box></geometry>
          <material><ambient>0.75 0.20 0.20 1</ambient><diffuse>0.75 0.20 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="post_fin">
      <static>true</static>
      <pose>-1.75 0.70 0.40 0 0 0.9</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.18 0.55 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.18 0.55 0.80</size></box></geometry>
          <material><ambient>0.85 0.80 0.20 1</ambient><diffuse>0.85 0.80 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
